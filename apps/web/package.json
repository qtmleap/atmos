{
  "name": "atmos-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "intlayer build && tsc -b --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy --keep-vars",
    "typecheck": "intlayer build && tsc --noEmit",
    "lint": "bunx --bun biome check",
    "format": "bunx --bun biome check --write",
    "test": "intlayer build && NODE_ENV=test bun test",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.39",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "drizzle-orm": "^0.45.3",
    "hono": "^4",
    "intlayer": "^9.5.8",
    "jose": "^6.2.12",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.6.7",
    "react": "^19",
    "react-dom": "^19",
    "react-intlayer": "^9.5.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@cloudflare/vite-plugin": "^1",
    "@cloudflare/workers-types": "^4",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans-jp": "5.3.0",
    "@happy-dom/global-registrator": "^20.14.5",
    "@playwright/mcp": "^0.0.81",
    "@qtmleap/vite-plugin-mock-diff": "0.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.40",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "^1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react-swc": "^4",
    "drizzle-kit": "^0.31.11",
    "happy-dom": "^20.14.5",
    "miniflare": "^5.20260921.0-alpha",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7",
    "vite": "^8",
    "vite-intlayer": "^9.5.8",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4"
  }
